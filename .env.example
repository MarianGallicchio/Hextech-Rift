# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RIOT_API_KEY: Development key from https://developer.riotgames.com
# Powers server/riot-proxy.mjs (never expose it in the frontend bundle).
# NEVER commit real keys — this file keeps placeholders only.
RIOT_API_KEY="PASTE_YOUR_RIOT_DEV_KEY_HERE"

# VITE_RIOT_PROXY_URL: where the frontend looks for the local Riot proxy.
# Default works with `npm run proxy`. Empty = simulator mode.
VITE_RIOT_PROXY_URL="http://localhost:4000"
